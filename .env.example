# Copy to .env (gitignored). Used by tools/publish_mongo.py to push the report
# bundle into MongoDB Atlas after each pipeline run. The <db_password>
# placeholder is replaced with the URL-encoded DB_PASSWORD.
DB_PASSWORD=your-atlas-password
MONGO_URI=mongodb+srv://<user>:<db_password>@<cluster-host>/?appName=Cluster0
# MONGO_DB=InvestOpediaClaude
