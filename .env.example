# OPTIONAL. tools/publish_mongo.py reads MONGO_URI/DB_PASSWORD from the environment,
# then from this file, then from data_acquisition/runpod/.env — which is where they
# normally live (the predict pod gets them from there). Copy to .env only if you
# want a separate set here. The <db_password> placeholder is replaced with the
# URL-encoded DB_PASSWORD.
DB_PASSWORD=your-atlas-password
MONGO_URI='mongodb+srv://<user>:<db_password>@<cluster-host>/?appName=Cluster0'
# MONGO_DB=InvestOpediaClaude
