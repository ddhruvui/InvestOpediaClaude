/data_tiingo/
# Other volume mirrors (borrow, calendar, finbert, M1 landing layer, whole-market panel)
/data_borrow/
/data_calendar/
/data_finbert/
/data_quality/
/m1/
/m1x/
.DS_Store
__pycache__/
*.pyc
.env

# --- prediction stack: generated / downloaded, never sourced from git ---
.pytest_cache/
scratch*/
*.log
# Every output lives on the RunPod volume under results/InvestOpediaClaude/ and reaches the
# console through MongoDB; nothing is kept here. A local rehearsal writes the same layout
# into ./results/, which must never be committed.
/results/

# --- app ---
node_modules/
app/*/dist/
app/backend/data/          # paper-book runtime state
# reports live in MongoDB only — the predict pod publishes them from the volume
# (pod_bootstrap_predict.sh publish_bundle); nothing is kept here or in git
/reports/
