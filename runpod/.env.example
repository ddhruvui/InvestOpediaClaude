# Copy to runpod/.env and fill in. .env is gitignored. This repo never calls a data vendor —
# the DataAcquistion repo does, and fills the RunPod network volume these jobs read. The two
# repos must point at the SAME volume (RUNPOD_VOLUME_ID) and use the same RunPod account.

# --- RunPod ACCOUNT API key (rpa_...) ---
# Creates pods (scripts/launch_predict.sh) and lets them self-terminate (RUNPOD_TERMINATE_KEY);
# also what scripts/reap_pods.sh uses to delete finished pods from this machine.
RUNPOD_API_KEY=rpa_xxx

# --- RunPod S3 API keys (Settings -> S3 API Keys) ---
# Used by every script that reads or writes the volume over S3 (logs, manifests, bundles).
AWS_ACCESS_KEY_ID=user_xxx
AWS_SECRET_ACCESS_KEY=rps_xxx

# --- Network volume (the hand-off from DataAcquistion) ---
RUNPOD_VOLUME_ID=xxxxxxxxxx
RUNPOD_S3_REGION=eu-ro-1                       # lowercase, for the aws CLI
RUNPOD_S3_ENDPOINT=https://s3api-eu-ro-1.runpod.io
RUNPOD_DATACENTER=EU-RO-1                       # uppercase, for pod create (must match the volume's DC)

# --- MongoDB Atlas (the deployed console's store) ---
# Passed into predict/publish pods, which push the report bundle straight to Mongo
# (scripts/launch_predict.sh predict|publish); also read by tools/publish_mongo.py.
# The <db_password> placeholder is replaced with the URL-encoded DB_PASSWORD.
# QUOTE the URI: this file is sourced by bash, where a bare <db_password> reads as a redirection.
MONGO_URI='mongodb+srv://<user>:<db_password>@<cluster-host>/?appName=Cluster0'
DB_PASSWORD=your-atlas-password
# MONGO_DB=InvestOpediaClaude

# --- Pod sizing (optional; defaults shown) ---
# RUNPOD_VCPU=8
# RUNPOD_IMAGE=python:3.11-slim
# RUNPOD_CPU_FLAVORS=["cpu3c","cpu5c"]           # valid: cpu3c cpu3g cpu3m cpu5c cpu5g cpu5m
# GPU_FALLBACK=1                                 # CPU jobs fall back to the cheapest free GPU
